{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "./entrypoints/**/*.ts",
    "./entrypoints/**/*.tsx",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./backend/**/*.ts",
    "./tests/**/*.ts",
    "./wxt.config.ts",
    "./.wxt/wxt.d.ts"
  ]
}
