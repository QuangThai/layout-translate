{
  "name": "layout-preserving-translation-extension",
  "version": "0.1.0-spike",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "framework:build": "vite build --config fixtures/vite.framework.config.ts",
    "calibration:smoke": "npm run build && node scripts/calibration-smoke.mjs",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run --environment node",
    "e2e:smoke": "npm run build && npm run framework:build && node scripts/e2e-smoke.mjs",
    "backend:mock": "tsx backend/src/mock-server.ts",
    "backend:live": "node scripts/start-live-backend.mjs",
    "live:site": "npm run build && node scripts/live-site-e2e.mjs",
    "dynamic:smoke": "npm run build && node scripts/dynamic-smoke.mjs",
    "live:smoke": "npm run build && node scripts/live-provider-smoke.mjs",
    "backend:smoke": "node scripts/backend-contract-smoke.mjs",
    "real-corpus:preflight": "node scripts/real-corpus-preflight.mjs",
    "real-corpus:calibration": "node scripts/real-corpus-calibration.mjs",
    "benchmark:translation": "node scripts/translation-benchmark.mjs",
    "benchmark:translation:provider": "node scripts/translation-benchmark-provider.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "wxt": "^0.21.4"
  }
}
